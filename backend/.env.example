# Razorpay test-mode credentials (Dashboard > Settings > API Keys > Test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Gemini API key (same one used in OKGIP / UFDR-INTEL)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash-lite

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///./recovery.db

# Recovery engine tuning
MAX_RETRY_ATTEMPTS=2
